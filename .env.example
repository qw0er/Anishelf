# Development stack options for the repository-root compose.yaml.
# Published-image deployment is documented in README.md.
# docker compose up -d --build works without a .env file.
# Copy this file to .env only when changing these deployment choices.

# Use an existing absolute HOST media directory instead of the managed volume.
# ANISHELF_MEDIA_PATH=/srv/anishelf/media

# Include the bundled downloader. Enter its credentials in Anishelf Settings.
# COMPOSE_PROFILES=qbittorrent

# For a domain/reverse proxy, set the exact browser-facing origin.
# ANISHELF_PUBLIC_ORIGIN=https://anime.example.com
# For direct LAN access, also bind the frontend to the server's LAN address.
# ANISHELF_BIND_ADDRESS=192.168.1.10
# ANISHELF_PUBLIC_ORIGIN=http://192.168.1.10:3000
