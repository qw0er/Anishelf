# Copy to .env. Compose reads this file after it is named .env.
# Both Anishelf images use this tag. Pin a published release for upgrades.
ANISHELF_TAG=latest
ANISHELF_BIND_ADDRESS=127.0.0.1
ANISHELF_PORT=3000
# Must match the browser origin, including a changed port or HTTPS domain.
ANISHELF_PUBLIC_ORIGIN=http://localhost:3000
TZ=Etc/UTC

# Default: anishelf-media named volume. Optional absolute HOST media directory,
# e.g. /srv/anishelf/media. Backend reads it; the bundled downloader writes it.
# Application state and incomplete downloads always use separate named volumes.
ANISHELF_MEDIA_PATH=

# Optional bundled downloader. Uncomment BOTH lines to enable it and prefill
# its backend-reachable API URL. Credentials are still entered in Settings.
# COMPOSE_PROFILES=qbittorrent
# ANISHELF_QBITTORRENT_API_URL=http://qbittorrent:8080
# If changing its WebUI port below, change the API URL port above as well.
# For an existing downloader, leave the profile disabled and optionally set
# ANISHELF_QBITTORRENT_API_URL to an address reachable from the backend.

# Optional browser-reachable WebUI link; blank means no default link.
# Example: https://downloads.example.com. Never use the Compose service name.
# This only initializes NEW settings; saved settings always win.
ANISHELF_INITIAL_QBITTORRENT_WEBUI_URL=

QBITTORRENT_TAG=latest
QBITTORRENT_BIND_ADDRESS=127.0.0.1
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_PEER_PORT=6881
# Backend runs as UID/GID 1000. Keep these aligned for the shared data layout.
QBITTORRENT_UID=1000
QBITTORRENT_GID=1000
