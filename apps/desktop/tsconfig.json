{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "nodenext",
		"target": "esnext",
		"moduleResolution": "nodenext",
		"lib": ["ESNext", "DOM"],
		"rewriteRelativeImportExtensions": true,
		"types": ["node"],
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src/main.ts"]
}
