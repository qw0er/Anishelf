{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"module": "nodenext",
		"target": "esnext",
		"types": ["node"],
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src/main"]
}
