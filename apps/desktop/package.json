{
	"name": "@anishelf/desktop",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "npm run build:main && npm run build:renderer",
		"predev": "npm run build:main",
		"dev": "electron . --renderer-dev",
		"start": "electron .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
		"build:main": "tsc",
		"build:renderer": "node ../../scripts/build-info.mjs apps/desktop && vite build",
		"dev:renderer": "node ../../scripts/build-info.mjs apps/desktop && vite"
	},
	"dependencies": {
		"@anishelf/client-core": "1.0.0",
		"@anishelf/client-ui": "1.0.0",
		"@anishelf/contracts": "1.0.0",
		"@fastify/send": "^4.2.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^45.3.1",
		"vite": "^8.3.4"
	}
}
