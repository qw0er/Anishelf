{
	"name": "@anishelf/desktop",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"scripts": {
		"prebuild": "node ../../scripts/build-info.mjs apps/desktop",
		"build": "tsc && vite build",
		"dev": "node dev.mjs",
		"start": "electron .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
		"test": "vitest run",
		"package": "npm run build && node prepare-package.mjs && electron-builder --projectDir dist/package"
	},
	"dependencies": {
		"@anishelf/client-core": "1.0.0",
		"@anishelf/client-ui": "1.0.0",
		"@anishelf/contracts": "1.0.0",
		"lucide-react": "^1.57.0",
		"platformdirs": "4.3.7",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.0.16",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^45.3.1",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.28.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
