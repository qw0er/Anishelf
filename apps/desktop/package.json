{
	"name": "@anishelf/desktop",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"scripts": {
		"build": "tsc && vite build",
		"predev": "npm run build",
		"dev": "electron .",
		"dev:renderer": "vite --host 127.0.0.1",
		"start": "electron .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json"
	},
	"dependencies": {
		"@anishelf/contracts": "1.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^45.3.1",
		"vite": "^8.3.4"
	}
}
