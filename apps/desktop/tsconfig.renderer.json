{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.renderer.tsbuildinfo"
	},
	"include": ["src/renderer"]
}
