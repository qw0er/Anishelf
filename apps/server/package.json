{
	"name": "@anishelf/backend",
	"license": "AGPL-3.0-only",
	"author": "QWER",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "ANISHELF_DATA_DIR=\"${ANISHELF_DATA_DIR-$(cd ../.. && pwd)/.temp/backend}\" NODE_ENV=development tsx watch src/index.ts | pino-pretty --colorize --translateTime SYS:standard",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"build": "tsc",
		"start": "node dist/index.js",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"generate:bangumi": "openapi-typescript src/modules/anime/external-works/bangumi/openapi.yaml -o src/modules/anime/external-works/bangumi/openapi.gen.ts && biome check --write src/modules/anime/external-works/bangumi/openapi.gen.ts",
		"auth": "tsx src/cli.ts auth",
		"prebuild": "node ../../scripts/build-info.mjs",
		"predev": "node ../../scripts/build-info.mjs"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/parse-torrent": "^11.0.1",
		"@types/proper-lockfile": "^4.1.4",
		"@types/semver": "^7.8.0",
		"drizzle-kit": "^0.31.11",
		"memfs": "^4.80.1",
		"openapi-typescript": "^7.13.0",
		"pino-pretty": "^13.2.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@anishelf/contracts": "1.0.0",
		"@api-wrappers/anilist-wrapper": "^4.0.1",
		"@api-wrappers/api-core": "^1.1.1",
		"@ctrl/qbittorrent": "10.1.1",
		"@fastify/cookie": "^11.1.5",
		"@fastify/cors": "^11.4.3",
		"@fastify/rate-limit": "^11.2.2",
		"@fastify/session": "^11.2.0",
		"@fastify/static": "^10.1.12",
		"@fastify/type-provider-typebox": "^6.3.0",
		"anitomy-ng": "1.0.10",
		"better-sqlite3": "^13.2.0",
		"chokidar": "^6.0.0",
		"drizzle-orm": "^0.45.4",
		"fast-fuzzy": "1.12.0",
		"fast-xml-parser": "5.12.1",
		"fast-xml-validator": "1.4.4",
		"fastify": "^5.12.8",
		"file-type": "^22.3.0",
		"ipaddr.js": "2.5.0",
		"openapi-fetch": "^0.17.0",
		"opencc-js": "1.4.2",
		"p-queue": "^10.0.0",
		"parse-torrent": "^11.0.24",
		"pino": "^10.4.0",
		"platformdirs": "4.3.7",
		"proper-lockfile": "^4.1.2",
		"rotating-file-stream": "^4.0.0",
		"semver": "^7.8.6",
		"typebox": "^1.4.7",
		"undici": "8.13.0",
		"yaml": "^2.9.1"
	},
	"exports": {
		".": "./dist/index.js",
		"./desktop": "./dist/desktop.js"
	}
}
