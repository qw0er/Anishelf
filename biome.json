{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["backend/src/modules/*/application/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["fastify", "@fastify/**"],
										"message": "Application use cases must be independent of HTTP."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["web/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@anishelf/backend/**",
											"!@anishelf/backend/contracts/**"
										],
										"message": "Web may import only browser-safe contracts."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
