{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"markdown": { "formatter": { "enabled": false } },
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/server/src/modules/*/*/application/**",
				"apps/server/src/modules/*/*/application.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["fastify", "@fastify/**"],
										"message": "Application use cases must be independent of HTTP."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/web/**",
				"packages/client-core/**",
				"packages/client-ui/**",
				"packages/contracts/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@anishelf/backend", "@anishelf/backend/**"],
										"message": "Use @anishelf/contracts for the shared protocol."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/client-core/src/**", "packages/contracts/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"window": "Use the client host for browser APIs.",
									"document": "DOM access belongs in the renderer.",
									"navigator": "Use the client host for device capabilities.",
									"localStorage": "Use host-provided storage.",
									"sessionStorage": "Use host-provided storage."
								}
							}
						}
					}
				}
			}
		}
	]
}
