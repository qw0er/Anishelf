{
	"compilerOptions": {
		"target": "esnext",
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src/api", "test", "vitest.config.ts"]
}
