{
	admin off
	auto_https off
	persist_config off
	# Apply the same filtering to runtime errors and access logs.
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				resp_headers delete
			}
		}
	}
}

:8080 {
	# The deployment's public origin is authoritative, not caller-supplied forwarding headers.
	map {$ANISHELF_PUBLIC_ORIGIN:http://localhost:3000} {public_scheme} {
		~^https:// https
		default http
	}
	root * /srv
	header Referrer-Policy no-referrer
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				resp_headers delete
			}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	@api path /api /api/*
	handle @api {
		# Preserve the browser's Host/Origin, cookies, CSRF tokens and Range headers.
		reverse_proxy backend:3000 {
			header_up X-Forwarded-Proto {public_scheme}
			flush_interval 100ms
			transport http {
				keepalive 5s
			}
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
