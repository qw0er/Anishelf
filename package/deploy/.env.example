# Deployment stack; use matching published Web/Backend images.
# ANISHELF_TAG=latest
# All settings are optional. Defaults work without a .env file.
# Application access. Public origin defaults to http://localhost:<ANISHELF_PORT>.
# ANISHELF_BIND_ADDRESS=127.0.0.1
# ANISHELF_PORT=3000
# ANISHELF_PUBLIC_ORIGIN=https://anime.example.com
# Private container proxies only; narrow to the bridge CIDR for custom deployments.
# ANISHELF_TRUSTED_PROXIES=loopback,uniquelocal

# Optional absolute HOST media directory; unset uses the media volume.
# Backend UID/GID 1000 must have read/traverse access.
# ANISHELF_MEDIA_PATH=/srv/anishelf/media

# Optional bundled downloader. WebUI port changes only the host publication;
# the backend API remains http://qbittorrent:8080.
# COMPOSE_PROFILES=qbittorrent
# QBITTORRENT_BIND_ADDRESS=127.0.0.1
# QBITTORRENT_WEBUI_PORT=8080
# QBITTORRENT_PEER_PORT=6881
# QBITTORRENT_TAG=latest

# Optional bundled source service; combine with qbittorrent as needed.
# COMPOSE_PROFILES=qbittorrent,jackett
# JACKETT_BIND_ADDRESS=127.0.0.1
# JACKETT_PORT=9117
# Jackett uses ghcr.io/linuxserver/jackett:latest; pull and recreate to update.
