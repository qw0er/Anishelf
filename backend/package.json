{
	"name": "@anishelf/backend",
	"license": "GPL-3.0-only",
	"author": "QWER",
	"version": "0.2.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "NODE_ENV=development tsx watch src/index.ts | pino-pretty --colorize --translateTime SYS:standard",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"build": "tsc",
		"start": "node dist/index.js",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.4",
		"drizzle-kit": "^0.31.11",
		"pino-pretty": "^13.2.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fastify/static": "^10.1.5",
		"@fastify/type-provider-typebox": "^6.1.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.3",
		"fastify": "^5.12.5",
		"file-type": "^22.1.1",
		"pino": "^10.4.0",
		"platformdirs": "4.3.7",
		"typebox": "^1.3.36"
	},
	"exports": {
		".": "./dist/index.js",
		"./contracts/http": {
			"types": "./src/contracts/http.ts"
		},
		"./contracts/subtitles": {
			"types": "./src/contracts/subtitles.ts",
			"default": "./src/contracts/subtitles.ts"
		},
		"./contracts/defaults": {
			"types": "./src/contracts/defaults.ts",
			"default": "./src/contracts/defaults.ts"
		},
		"./contracts/media": {
			"types": "./src/contracts/media.ts",
			"default": "./src/contracts/media.ts"
		}
	}
}
