{
	"name": "anishelf",
	"license": "AGPL-3.0-only",
	"author": "QWER",
	"version": "1.7.0",
	"private": true,
	"workspaces": [
		"apps/desktop",
		"apps/server",
		"apps/web",
		"packages/contracts",
		"packages/client-core",
		"packages/client-ui"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@typescript/native": "npm:typescript@~7.0.2",
		"concurrently": "^10.0.6",
		"dependency-cruiser": "^18.7.0",
		"knip": "^6.42.1",
		"npm-check-updates": "^23.1.1",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"scripts": {
		"deps:check": "npm-check-updates",
		"typecheck": "npm run typecheck --workspaces",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"lint": "biome lint . && npm run architecture:check && npm run unused:check",
		"check": "npm run biome:check && npm run lint && npm run typecheck && npm test",
		"test:installer": "python3 -m unittest discover -s scripts/installer_tests -v",
		"test:deployment": "npm run test:installer && node --test deployment/qbittorrent-init.test.mjs deployment/jackett-init.test.mjs",
		"test": "npm run architecture:test && npm run test:deployment && npm run test --workspace @anishelf/web && npm run test --workspace @anishelf/desktop && npm run test --workspace @anishelf/client-core && npm run test --workspace @anishelf/backend && npm run test --workspace @anishelf/client-ui",
		"build": "npm run build --workspaces --if-present",
		"dev": "npm run dev:web",
		"dev:web": "concurrently --kill-others --success first --names backend,web \"npm run dev:backend\" \"npm run dev:web:client\"",
		"dev:desktop": "npm run dev:desktop:client",
		"dev:web:lan": "concurrently --kill-others --success first --names backend,web \"npm run dev:backend\" \"npm run dev:web:client -- --host 0.0.0.0\"",
		"dev:backend": "ANISHELF_LOG_LEVEL=debug npm run dev --workspace @anishelf/backend",
		"dev:web:client": "npm run dev --workspace @anishelf/web",
		"dev:desktop:client": "npm run dev --workspace @anishelf/desktop",
		"start": "npm run start:web",
		"prestart:web": "npm run build --workspace @anishelf/backend --workspace @anishelf/web",
		"start:web": "ANISHELF_FRONTEND_DIR=\"$PWD/apps/web/dist\" npm run start:backend",
		"prestart:desktop": "npm run build --workspace @anishelf/backend --workspace @anishelf/desktop",
		"start:desktop": "npm run start:desktop:client",
		"start:backend": "npm run start --workspace @anishelf/backend",
		"start:desktop:client": "npm run start --workspace @anishelf/desktop --",
		"architecture:check": "node scripts/check-architecture.mjs",
		"architecture:test": "node --test scripts/architecture.test.mjs scripts/release-notes.test.mjs",
		"unused:check": "knip --no-progress",
		"package:desktop": "npm run package --workspace @anishelf/desktop --"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"better-sqlite3@13.0.3": true,
		"lfa-ponyfill@1.1.1": true,
		"fsevents@2.3.3": true
	}
}
