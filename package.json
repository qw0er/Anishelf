{
	"name": "anishelf",
	"license": "GPL-3.0-only",
	"author": "QWER",
	"version": "0.2.6",
	"private": true,
	"workspaces": [
		"backend",
		"web"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"concurrently": "^10.0.5",
		"dependency-cruiser": "^18.5.0",
		"knip": "^6.39.0",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"@typescript/native": "npm:typescript@~7.0.2"
	},
	"scripts": {
		"typecheck": "npm run typecheck --workspaces",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"lint": "biome lint . && npm run architecture:check && npm run unused:check",
		"check": "npm run biome:check && npm run lint && npm run typecheck && npm test",
		"test": "npm run architecture:test && npm run test --workspaces --if-present",
		"build": "npm run build --workspaces",
		"start": "npm run build && ANISHELF_FRONTEND_DIR=\"./web/dist\" npm run start --workspace @anishelf/backend",
		"start:backend": "npm run start --workspace @anishelf/backend",
		"dev:backend": "npm run dev --workspace @anishelf/backend",
		"dev:web": "npm run dev --workspace @anishelf/web",
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
		"dev:host": "concurrently \"npm run dev:backend\" \"npm run dev --workspace @anishelf/web -- --host 0.0.0.0\"",
		"package_source": " mkdir -p ./dist && git archive --format=tar --prefix=anishelf/ HEAD | zstd -f -o ./dist/anishelf.tar.zst",
		"architecture:check": "node scripts/check-architecture.mjs",
		"architecture:test": "node --test scripts/architecture.test.mjs",
		"unused:check": "knip --no-progress"
	}
}
