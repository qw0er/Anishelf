[Unit]
Description=Authorize bundled Jackett first-run site setup
PartOf=anishelf.target

[Container]
Image=ghcr.io/qw0er/anishelf-backend:latest
UserNS=keep-id:uid=1000,gid=1000
User=0
Group=0
Volume=anishelf-jackett-config.volume:/config
Exec=node /app/package/jackett-init.mjs

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
